# Copy to .env and fill in. .env is gitignored. This suite never points at production.
#
# PREREQUISITES: four port-forwards must be running before anything works: scripts/tunnels.sh up.
#   kubectl port-forward -n be-crud     svc/be-crud-v5       3000:80
#   kubectl port-forward -n integration svc/webhooks-api     8081:80
#   kubectl port-forward -n snc         svc/scorecard-v2-api 3001:80
#   kubectl port-forward -n ingestion   svc/digestion        3002:80
# The backend-crud forward MUST bind local port 3000, because the Host header `localhost:3000`
# is what puts the request on backend-crud's intra-service path.
# The scorecards forward serves /v2/threshold-events/search and /transfer, which are NOT in
# backend-crud. It takes the same requestor + account_id headers and no token.
# The fourth forward is hapi-plugin-digestion-api (deployed as `digestion-api` / image
# hapi-server-digestion-api, service name `digestion`, namespace `ingestion` —
# `_tools/fluxcd-deployment/ingestion/digestion.yaml`; confirmed reachable in-cluster at
# `http://digestion.ingestion.svc.cluster.local` with no port suffix, i.e. port 80, from three
# other services' own configmaps that already call it: `geofence/realtime-geofencing-config.yaml`,
# `snc/scorecard-v2-config.yaml`, `parts/parts-config.yaml`). Resolves the Rosco secondary tracker
# via the `{secondaryTracker:<device_id>}` Redis key (AGENT-BRIEF non-obvious fact 2); provisioning
# polls it after installing a tracker and fails loudly if it never resolves.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# The account under test. It needs account_integrations.partner = 'rosco' and the
# TennaCAM Facial Recog licence. The preflight spec checks both and enables the licence.
ACCOUNT_ID=

# REQUIRED. Preflight reads ACCOUNT_ID's name back from backend-crud and refuses to provision
# anything unless it equals this. ENV (below) is a label and CRUD_BASE_URL is always
# http://localhost:3000/api regardless of which cluster your kubectl port-forward is actually
# bound to — this is the one check that catches a wrong kube-context before it writes assets,
# trackers and trips into a real account. Set it to the exact name of your nonprod fixture account.
EXPECTED_ACCOUNT_NAME=

# Per-fleet override, same idea as ASSET_ID_<FLEET> below. REQUIRED for fr-licence specifically:
# that fleet runs on ACCOUNT_ID_FR_LICENCE, a different account from the shared ACCOUNT_ID (see
# below), so it has a different real name and can never pass the check above without its own
# override. Falls back to EXPECTED_ACCOUNT_NAME when unset, for every other fleet.
# EXPECTED_ACCOUNT_NAME_FR_LICENCE=

# Every test writes, so nothing runs without this. Commented out on purpose: copying this file
# must not silently turn mutations on. Uncomment once you have read what the suite creates.
# ALLOW_MUTATIONS=1

# ---------------------------------------------------------------------------
# Hosts. Defaults match the four port-forwards above.
# ---------------------------------------------------------------------------
# ENV is a label used in fixture names and the run manifest. It does not select a host.
ENV=dv3
# CRUD_BASE_URL=http://localhost:3000/api
# WEBHOOK_BASE_URL=http://localhost:8081
# SCORECARDS_BASE_URL=http://localhost:3001
# DIGESTION_BASE_URL=http://localhost:3002

# ---------------------------------------------------------------------------
# Fixture pinning. Optional, except ACCOUNT_ID_FR_LICENCE below, which is required if you run the
# fr-licence fleet at all.
# ---------------------------------------------------------------------------
# Pin one asset for the whole run, instead of provisioning one per suite.
# ASSET_ID=
# TRACKER_ID=
# VEHICLE_ID=
#
# Pin an asset for a single suite. The name is the suite's fleet, upper-cased, non-alphanumerics
# replaced by underscores. Suites are fr-live, fr-trip-lookup, fr-delayed, fr-guards, fr-race,
# fr-licence, fr-phase2.
# ASSET_ID_FR_LIVE=
# ASSET_ID_FR_DELAYED=
#
# REQUIRED for the fr-licence fleet, not optional: it revokes and re-grants an account-scoped
# licence (O18/O19), which would otherwise apply to every other suite mutating the shared
# ACCOUNT_ID at the same time (4 workers, PW_WORKERS below). Preflight refuses to run fr-licence
# without this set to an account different from ACCOUNT_ID.
# ACCOUNT_ID_FR_LICENCE=

# ---------------------------------------------------------------------------
# Emitter
# ---------------------------------------------------------------------------
# webhook = POST straight to the in-cluster webhook route over the port-forward. Works today.
# becrud  = POST /v5/rosco-events/publish. BLOCKED: that schema still requires event_id and
#           pins name to the enum ["events"], so it cannot carry Type 6 or Type 7 yet.
EMITTER=webhook

# ---------------------------------------------------------------------------
# Driver-event reader. API first; SQL only for what the API cannot answer.
# ---------------------------------------------------------------------------
DRIVER_EVENTS_READER=api
# Needed only when DRIVER_EVENTS_READER=sql, over the engineering tunnel:
#   _tools/engineering-tools/scripts/db-tunnel.sh --environment dv3     (opens localhost:54334)
# DB_URL=postgresql://<user>:<pass>@localhost:54334/<database>

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
# FR_DEBUG=1      one log line per API call
# FR_DRY_RUN=1    print what would be sent, send nothing
# PW_WORKERS=4    parallel workers, one asset per spec file
